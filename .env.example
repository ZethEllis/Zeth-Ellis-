# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key   # or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Only used by `npm run seed` (never expose to the browser, never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used for auth email redirects; set to your Vercel URL in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: AI comparison on /compare (Gemini via OpenRouter). Server-only, never prefix with NEXT_PUBLIC_
OPENROUTER_API_KEY=sk-or-v1-your-key
# OPENROUTER_MODEL=google/gemini-2.5-flash
